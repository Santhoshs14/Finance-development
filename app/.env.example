# ─────────────────────────────────────────────────────────────────────────
# WealthFlow environment variables — TEMPLATE
#
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# All values below are placeholders. `NEXT_PUBLIC_*` vars are exposed to the
# browser bundle (safe for Firebase web config); everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────

# ── Public Firebase web config (safe to expose in client bundle) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=          # optional (Analytics)

# ── Server-only: Firebase Admin SDK service account (REQUIRED) ──
# Settings → Service accounts → Generate new private key. Keep the literal
# "\n" sequences in the private key; the app converts them to newlines.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Cron (required on Vercel for /api/cron/*) ──
CRON_SECRET=

# ── Sentry error monitoring (optional) ──
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=                            # CI/build-time source-map upload only
NEXT_PUBLIC_SENTRY_DSN=

# ── Web push / FCM (optional) ──
# Firebase Console → Cloud Messaging → Web Push certificates → key pair.
NEXT_PUBLIC_FCM_VAPID_KEY=

# ── WebAuthn passkeys (required for 2FA in production) ──
WEBAUTHN_RP_ID=yourdomain.com                 # exact hostname, no scheme/port
WEBAUTHN_ORIGIN=https://yourdomain.com        # comma-separated for multiple
WEBAUTHN_RP_NAME=WealthFlow                   # display name shown in the passkey prompt

# ── Vercel KV for distributed rate-limiting (REQUIRED in production on serverless) ──
# Without these the rate limiter falls back to a per-instance in-memory map that
# does NOT share state across serverless invocations. Set both in production.
# Set RATE_LIMIT_REQUIRE_KV=false ONLY for local/preview builds without KV.
KV_REST_API_URL=
KV_REST_API_TOKEN=
RATE_LIMIT_REQUIRE_KV=true

# ── Upstash QStash — distributed fan-out for cron jobs (required on Vercel) ──
# Dashboard → QStash. Used to fan out per-user cron work across many small,
# retried worker invocations instead of one long-running loop.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Base URL the dispatcher uses to build worker callback URLs (your deployment
# origin, e.g. https://yourdomain.com). Falls back to VERCEL_URL when unset.
QSTASH_TARGET_BASE_URL=

# ── Automated Firestore backups (optional; for /api/cron/backup) ──
# GCS bucket the daily backup exports to. The Admin SDK service account needs
# roles/datastore.importExportAdmin and write access to this bucket.
GCS_BACKUP_BUCKET=

# ── Foreign-exchange rates (optional; for /api/cron/fetch-fx) ──
# Keyless by default (open.er-api.com, which includes AED). Amounts are stored
# in INR and only converted for display. Override for a different provider that
# exposes `${FX_API_BASE_URL}/latest/INR`.
FX_API_BASE_URL=https://open.er-api.com/v6

# ── Dev only — skips Firebase auth in API routes (ignored in production) ──
DEV_AUTH_BYPASS=false
