rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────────────────
    // Helpers
    // ───────────────────────────────────────────────────────────
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Root user document
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      // ── Transactions ─────────────────────────────────────────
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.amount is number
          && request.resource.data.amount > -1000000000000
          && request.resource.data.amount < 1000000000000
          && request.resource.data.date is string
          && request.resource.data.category is string
          && request.resource.data.keys().hasAll(['amount', 'date', 'category']);
        allow update: if isOwner(userId)
          && (!('amount' in request.resource.data)
              || (request.resource.data.amount is number
                  && request.resource.data.amount > -1000000000000
                  && request.resource.data.amount < 1000000000000));
        allow delete: if isOwner(userId);
      }

      // ── Accounts ─────────────────────────────────────────────
      match /accounts/{accountId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.account_name is string
          && request.resource.data.account_name.size() > 0
          && request.resource.data.account_name.size() <= 100
          && request.resource.data.type in ['bank', 'savings', 'current', 'wallet', 'cash', 'credit']
          && (!('balance' in request.resource.data) || request.resource.data.balance is number)
          && (!('credit_limit' in request.resource.data) || request.resource.data.credit_limit is number)
          && (!('billing_cycle_start_day' in request.resource.data) || request.resource.data.billing_cycle_start_day is number);
        allow update: if isOwner(userId)
          && (!('account_name' in request.resource.data) || request.resource.data.account_name is string)
          && (!('type' in request.resource.data) || request.resource.data.type is string)
          && (!('balance' in request.resource.data) || request.resource.data.balance is number)
          && (!('credit_limit' in request.resource.data) || request.resource.data.credit_limit is number)
          && (!('billing_cycle_start_day' in request.resource.data) || request.resource.data.billing_cycle_start_day is number);
        allow delete: if isOwner(userId);
      }

      // ── Categories ───────────────────────────────────────────
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 50
          && request.resource.data.type in ['income', 'expense'];
        allow update, delete: if isOwner(userId);
      }

      // ── Aggregates ───────────────────────────────────────────
      match /aggregates/{cycleKey} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && (!('totalSpent' in request.resource.data) || request.resource.data.totalSpent is number)
          && (!('totalIncome' in request.resource.data) || request.resource.data.totalIncome is number);
      }

      // ── Budget Snapshots ─────────────────────────────────────
      match /budgetSnapshots/{cycleKey}/categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      // ── Goals ────────────────────────────────────────────────
      match /goals/{id} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.goal_name is string
          && request.resource.data.goal_name.size() > 0
          && request.resource.data.goal_name.size() <= 100
          && request.resource.data.target_amount is number
          && request.resource.data.keys().hasAll(['goal_name', 'target_amount']);
        allow update: if isOwner(userId)
          && (!('goal_name' in request.resource.data) || request.resource.data.goal_name is string)
          && (!('target_amount' in request.resource.data) || request.resource.data.target_amount is number)
          && (!('current_amount' in request.resource.data) || request.resource.data.current_amount is number);
        allow delete: if isOwner(userId);
      }

      // ── Investments ──────────────────────────────────────────
      match /investments/{id} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 150
          && request.resource.data.buy_price is number
          && request.resource.data.quantity is number
          && request.resource.data.keys().hasAll(['name', 'buy_price', 'quantity']);
        allow update: if isOwner(userId)
          && (!('buy_price' in request.resource.data) || request.resource.data.buy_price is number)
          && (!('current_price' in request.resource.data) || request.resource.data.current_price is number)
          && (!('quantity' in request.resource.data) || request.resource.data.quantity is number);
        allow delete: if isOwner(userId);
      }

      // ── Mutual Funds (legacy; migrated into investments via Admin SDK) ──
      match /mutualFunds/{id} { allow read, write: if isOwner(userId); }

      // ── SIPs (systematic investment plans) ───────────────────
      match /sips/{id} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.frequency in ['weekly', 'monthly', 'yearly']
          && request.resource.data.scheme_code is string
          && request.resource.data.scheme_code.size() > 0
          && request.resource.data.keys().hasAll(['amount', 'frequency', 'scheme_code', 'next_date', 'account_id']);
        allow update: if isOwner(userId)
          && (!('amount' in request.resource.data) || request.resource.data.amount is number)
          && (!('frequency' in request.resource.data) || request.resource.data.frequency in ['weekly', 'monthly', 'yearly'])
          && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'paused', 'stopped']);
        allow delete: if isOwner(userId);
      }

      // ── Lending ──────────────────────────────────────────────
      match /lending/{id} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.person_name is string
          && request.resource.data.person_name.size() > 0
          && request.resource.data.person_name.size() <= 100
          && request.resource.data.amount is number
          && request.resource.data.type in ['lent', 'borrowed']
          && request.resource.data.keys().hasAll(['person_name', 'amount', 'type']);
        allow update: if isOwner(userId)
          && (!('amount' in request.resource.data) || request.resource.data.amount is number)
          && (!('paid_amount' in request.resource.data) || request.resource.data.paid_amount is number)
          && (!('type' in request.resource.data) || request.resource.data.type in ['lent', 'borrowed'])
          && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'partial', 'completed']);
        allow delete: if isOwner(userId);
      }

      // ── EMIs ─────────────────────────────────────────────────
      match /emis/{id} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 200
          && request.resource.data.totalAmount is number
          && request.resource.data.emiAmount is number
          && request.resource.data.keys().hasAll(['description', 'totalAmount', 'emiAmount']);
        allow update: if isOwner(userId)
          && (!('totalAmount' in request.resource.data) || request.resource.data.totalAmount is number)
          && (!('emiAmount' in request.resource.data) || request.resource.data.emiAmount is number)
          && (!('monthsPaid' in request.resource.data) || request.resource.data.monthsPaid is number);
        allow delete: if isOwner(userId);
      }

      // ── Recurring templates ──────────────────────────────────
      match /recurring/{id} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 200
          && request.resource.data.amount is number
          && request.resource.data.frequency in ['weekly', 'monthly', 'yearly']
          && request.resource.data.keys().hasAll(['description', 'amount', 'frequency']);
        allow update: if isOwner(userId)
          && (!('amount' in request.resource.data) || request.resource.data.amount is number)
          && (!('frequency' in request.resource.data) || request.resource.data.frequency in ['weekly', 'monthly', 'yearly'])
          && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'paused', 'stopped']);
        allow delete: if isOwner(userId);
      }

      // ── Splits ───────────────────────────────────────────────
      match /splits/{id} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 200
          && request.resource.data.total_amount is number
          && request.resource.data.keys().hasAll(['description', 'total_amount']);
        allow update: if isOwner(userId)
          && (!('total_amount' in request.resource.data) || request.resource.data.total_amount is number)
          && (!('settled' in request.resource.data) || request.resource.data.settled is bool);
        allow delete: if isOwner(userId);
      }

      // ── Notifications (Admin-SDK created only; client marks read / deletes) ──
      match /notifications/{id} {
        allow read: if isOwner(userId);
        // Notifications are created exclusively server-side via the Admin SDK
        // (cron jobs + API routes), which bypasses these rules. Blocking client
        // creates prevents forged/injected notifications.
        allow create: if false;
        allow update: if isOwner(userId)
          && (!('read' in request.resource.data) || request.resource.data.read is bool);
        allow delete: if isOwner(userId);
      }

      // ── Net-worth snapshots (written by cron via Admin SDK) ──
      match /netWorthSnapshots/{id} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (!('net_worth' in request.resource.data) || request.resource.data.net_worth is number)
          && (!('month' in request.resource.data) || request.resource.data.month is string);
        allow delete: if isOwner(userId);
      }

      // ── FCM device tokens ────────────────────────────────────
      match /fcmTokens/{tokenHash} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (!('token' in request.resource.data) || request.resource.data.token is string);
        allow delete: if isOwner(userId);
      }

      // ── NAV history (read-only; written by NAV cron via Admin SDK) ──
      match /navHistory/{path=**} { allow read: if isOwner(userId); }

      // ── Profile / settings ───────────────────────────────────
      match /profile/{document=**} { allow read, write: if isOwner(userId); }

      // ── Audit log — read-only from client (Admin SDK writes only) ──
      match /audit/{id} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ── Passkeys — locked. Only Admin SDK may write. ──
      match /passkeys/{credentialId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ── Security state (WebAuthn challenge etc.) — Admin SDK only ──
      match /security/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ── Idempotency ledger — Admin SDK only. Reads are granted by the
      // catch-all below (rules are OR-evaluated, so a `read: if false` here
      // would be misleading); records only ever hold the owner's own prior
      // response bodies, so owner-read is harmless. ──
      match /_idempotency/{key} {
        allow write: if false;
      }

      // ── Deletion tombstones — drive incremental sync. Owner reads only. ──
      match /_tombstones/{id} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ── Sync beacon — bumped server-side on every write. Owner reads only. ──
      match /_sync/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ── Catch-all: owner may READ any future read-model subcollection. ──
      // Writes are intentionally NOT granted here. Firestore evaluates match
      // rules with OR semantics, so a blanket `write` would override the
      // field-level validation on the collections above and the `write: if
      // false` locks on passkeys/security/audit. All mutations happen
      // server-side via the Admin SDK (which bypasses rules); the only
      // client-side writes are to the collections explicitly allowed above.
      match /{subcollection}/{documentId=**} {
        allow read: if isOwner(userId);
      }
    }

    // ───────────────────────────────────────────────────────────
    // System collections (NAV index, gold prices) — read by all
    // authenticated users, written only by Admin SDK.
    // ───────────────────────────────────────────────────────────
    match /system/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
